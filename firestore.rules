rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'hbrito@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /trees/family {
      allow get: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['people', 'revision', 'updatedAt', 'updatedBy'])
        && request.resource.data.people is map
        && request.resource.data.people.size() > 0
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision is int
        && ((!exists(/databases/$(database)/documents/trees/family) && request.resource.data.revision == 1)
          || (resource != null && request.resource.data.revision == resource.data.revision + 1));
      allow delete, list: if false;
    }
  }
}
